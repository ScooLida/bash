#!/bin/bash

# Путь к скриптам PSMC 
#PSMC_UTILS="/path/to/psmc/utils"

script -a session.log 
date "+%H:%M %d.%m.%Y" 

mkdir ./psms


samtools view -b --sample DonHare1 -o ./psms/DonHare1_only.bam input_merged.bam
samtools index ./psms/DonHare1_only.bam


# Проходим циклом по всем разделенным BAM-файлам
for bam in *.bam; do
    sample=$(basename "$bam" .bam)
    echo "Processing sample: $sample"

    samtools mpileup -uf reference.fasta "$bam" | \
    bcftools call -c | \
    vcfutils.pl vcf2fq > "${sample}.fastq

    # 2. Конвертация FASTQ в PSMCFA
    # Это формат, где геном разбит на бины (обычно по 100 bp)
    $PSMC_UTILS/fq2psmcfa "${sample}.fastq" > "${sample}.psmcfa"

    echo "Done with $sample"
done
