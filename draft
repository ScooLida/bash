#!/bin/bash

# --- НАСТРОЙКИ (проверь пути!) ---
LIST="list_psmc.txt"              # Файл со списком образцов (SM names)
MERGED_BAM="input_merged.bam"     # Твой общий BAM файл
REF="reference.fasta"             # Референс зайца
OUT_DIR="./psms"                  # Куда класть результат
PSMC_UTILS="/path/to/psmc/utils"  # ПУТЬ к папке psmc/utils (там fq2psmcfa)
MUTATION_RATE="2.5e-08"           # Скорость мутации
GENERATION_TIME="2"               # Время генерации

# Создаем папки
mkdir -p $OUT_DIR

# --- ЦИКЛ ОБРАБОТКИ ---
while read -r sample; do
    echo ">>>>>>> ОБРАБОТКА ОБРАЗЦА: $sample [$(date +'%H:%M:%S')] <<<<<<<"

    # 1. Извлекаем образец из общего BAM
    samtools view -b --sample "$sample" "$MERGED_BAM" -o "$OUT_DIR/${sample}_raw.bam"

    # 2. ШАГ ДЛЯ ДРЕВНЕЙ ДНК: Режем хвосты по 3 нуклеотида
    # (Нужен пакет bamUtil или команда trimBam)
    trimBam "$OUT_DIR/${sample}_raw.bam" "$OUT_DIR/${sample}_trimmed.bam" 3
    
    # Индексируем обрезанный файл
    samtools index "$OUT_DIR/${sample}_trimmed.bam"

    # 3. Делаем консенсус (FASTQ) без жестких фильтров глубины
    samtools mpileup -uf "$REF" "$OUT_DIR/${sample}_trimmed.bam" | \
    bcftools call -c | \
    vcfutils.pl vcf2fq > "$OUT_DIR/${sample}.fastq"

    # 4. Подготовка для PSMC (бинирование)
    $PSMC_UTILS/fq2psmcfa "$OUT_DIR/${sample}.fastq" > "$OUT_DIR/${sample}.psmcfa"

    # 5. Запуск расчета PSMC
    psmc -N25 -t15 -r5 -p "4+25*2+4+6" -o "$OUT_DIR/${sample}.psmc" "$OUT_DIR/${sample}.psmcfa"

    # Чистим временные тяжелые BAM-файлы (опционально, чтобы не забить диск)
    # rm "$OUT_DIR/${sample}_raw.bam" "$OUT_DIR/${sample}_trimmed.bam"

    echo ">>>>>>> ГОТОВО: $sample <<<<<<<"

done < "$LIST"

# --- ФИНАЛЬНЫЙ ГРАФИК ---
echo "СТРОИМ ОБЩИЙ ГРАФИК..."
ALL_PSMC=$(ls $OUT_DIR/*.psmc)
perl psmc_plot.pl -u $MUTATION_RATE -g $GENERATION_TIME "$OUT_DIR/combined_plot" $ALL_PSMC

echo "ВСЁ! Результаты в папке $OUT_DIR"



chmod +x run_hare_psmc.sh
















